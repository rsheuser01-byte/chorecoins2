# These values are intentionally public browser configuration. Never put private
# database URLs, service-role keys, Plaid secrets, or encryption keys in VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
VITE_PLAID_MOCK_MODE=true

# Source release lock also prevents activation; flag alone cannot enable cloud.
# Enable only after reviewed live migration and separate code-release approval.
VITE_CLOUD_SYNC_ENABLED=false
