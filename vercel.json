{
  "buildCommand": "node scripts/build-learning-preview.mjs",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/account-auth-isolation-20261027": false,
      "codex/in-app-reminders-20261027": false,
      "codex/chorecoins2-learning-redesign": true
    }
  }
}
